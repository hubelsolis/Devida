    <TfrxReportTitle Name="ReportTitle1" Height="536.02189612" Left="0" Top="18.89765" Width="718.1107">
      <TfrxMemoView Name="Memo2" Left="11.33858024" Top="234.33086" Width="695.43307331" Height="83.14966" DisplayFormat.DecimalSeparator="." Font.Charset="1" Font.Color="-16777208" Font.Height="-13" Font.Name="Arial" Font.Style="0" HAlign="haBlock" ParentFont="False" Text="Mediante la presente me dirijo a usted para expresarle mi cordial saludo, y a su vez remitirle el informe que explica la necesidad de suscripción de adenda al acta de entendimiento de las familias beneficiarias de la actividad de [ACTIVIDAD] de la Oficina Zonal Tingo Maria, en la cual, las modificaciones a realizarse en esta adenda son: inclusión, exclusión, cambio de titularidad de beneficiarios y/o reducción, incremento, cambio de etapa de crecimiento a producción de hectáreas."/>
      <TfrxMemoView Name="Memo3" Left="11.33859" Top="28.20110846" Width="695.79448635" Height="17.44398462" DisplayFormat.DecimalSeparator="." Font.Charset="1" Font.Color="-16777208" Font.Height="-13" Font.Name="Arial" Font.Style="1" ParentFont="False" Text="INFORME N°[NROINFORME]"/>
