      <TfrxMemoView Name="Memo186" Left="3.77953" Top="540.47279" Width="702.99258" Height="60.47248" DisplayFormat.DecimalSeparator="." Font.Charset="1" Font.Color="-16777208" Font.Height="-11" Font.Name="Arial" Font.Style="0" HAlign="haCenter" ParentFont="False" Text="_________________________&#13;&#10;[NOMBRECOORDINADOR]&#13;&#10;DNI [DNICOORDINADOR]"/>
